# Copy to backend/.env and fill in the keys:  cp backend/.env.example backend/.env

# ── Weather: WeatherAPI.com ──────────────────────────────────────────
# Sign up at https://www.weatherapi.com/ → Dashboard → API key.
WEATHERAPI_KEY=your-weatherapi-key
WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1
WEATHER_FORECAST_DAYS=3            # days of hourly forecast to plan over (free plan: up to 3)
WEATHER_CACHE_TTL_SECONDS=3600     # reuse a stored forecast snapshot for this long
WEATHER_TIMEOUT_SECONDS=10

# ── Gemini: natural-language explanations ─────────────────────────────
# Get a key at https://aistudio.google.com/apikey.
# Optional: when blank, the backend falls back to template explanations.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=20

# ── App ───────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/fieldday   # default: SQLite at backend/fieldday.db
CORS_ORIGINS=http://localhost:8443,http://localhost:5173
CANDIDATE_STEP_MINUTES=30          # spacing between candidate start times
OPTIMIZER_TIME_LIMIT_SECONDS=5
